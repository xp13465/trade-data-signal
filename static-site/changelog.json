  ],
  "20260908-a560": [
    "\u76d8\u4e2d\u589e\u91cf\u56de\u6d4b\u6863:\u4ea4\u6613\u65e5 9:40 \u81ea\u52a8\u8865\u8dd1\u5f53\u65e5\u4fe1\u53f7\u4ea4\u6613, \u76d8\u4e2d\u5373\u53ef\u770b\u5230\u6700\u65b0\u5165\u8d26"
  ],
  "20260908-a559": [
    "\u6ce2\u6bb5\u8c03\u6574\u7b49\u5356\u7c7b\u8b66\u793a\u4fe1\u53f7\u4e0d\u88ab AI \u964d\u4e8f\u7f6e\u7070/\u4e0d\u88ab\u300c\u4ec5\u663e\u793a\u53ef\u7528\u4fe1\u53f7\u300d\u9690\u85cf, \u5e38\u9a7b\u63d0\u793a",
    "\u516c\u793a\u540c\u6b65:\u6ce2\u6bb5\u8c03\u6574\u5356\u7c7b\u8b66\u793a\u300c\u65e0\u5b87\u5b99\u95e8\u69db\u300d\u53e3\u5f84 4 \u5904 tooltip \u8865\u6b63(\u00a721)"
  ],
  "20260908-a558": [
    "\u4fe1\u53f7\u51ef\u5229\u56de\u6d4b\u8865\u9f50\u8def\u5f84\u9759\u9ed8\u5316:\u4e2a\u522b\u6807\u7684\u7f3a\u4ef7\u4e0d\u518d\u5361\u4f4f\u6574\u4e2a\u56de\u6d4b,\u81ea\u52a8\u8865\u9f50\u5e76\u8f7b\u63d0\u793a",
    "\u9996\u9875\u6a21\u62df\u56de\u6d4b\u5f39\u7a97\u6e10\u8fdb\u52a0\u8f7d:\u8fd11\u5e74\u5148\u7b97\u5148\u5c55\u793a,\u540e\u53f0\u81ea\u52a8\u8865\u5168\u5168\u91cf",
    "\u5168\u91cf\u8ba1\u7b97\u6807\u6ce8 positionCap \u524d\u63d0(\u4ec5\u6807\u6ce8\u6570\u636e\u53e3\u5f84,\u4e0d\u6539\u53d8\u5b9e\u76d8)",
    "\u4fee\u590d\u4ea4\u6613\u8bb0\u5f55\u65ad\u6863:9/4 \u4fe1\u53f7(159023/159173 \u7b49)\u4ea4\u6613\u5df2\u8865\u9f50\u4e0a\u7ebf"
  ],
  "20260907-a554": [
    "\u6a21\u62df\u56de\u6d4b\u5f39\u7a97\u4e70\u5165\u53e3\u5f84\u53cc\u6863\u5207\u6362(\u6b21\u65e5\u5f00\u76d8\u9ed8\u8ba4/\u5f53\u65e5\u6536\u76d8),\u4e0e lab \u51ef\u5229\u5f00\u5173\u5404\u81ea\u72ec\u7acb\u4e92\u4e0d\u5f71\u54cd",
    "\u8ba1\u5212\u4e70\u5165\u65f6\u95f4\u5217\u4e0a\u4e0b\u6362\u884c\u5c55\u793a\u5b9e\u9645\u4e70\u5165\u65e5(\u4e0a=\u4fe1\u53f7\u65e5\u671f,\u4e0b=\u6309\u53e3\u5f84\u5b9e\u9645\u4e70\u5165),\u9996\u5217\u6539\u300c\u4fe1\u53f7\u65e5\u671f\u300d\u5b8c\u5584\u5217\u8bed\u4e49"
  ],
  "20260907-a553": [
    "\u6a21\u62df\u56de\u6d4b\u5f39\u7a97\u4ea4\u6613\u8bb0\u5f55\u8868\u65b0\u589e\u4e70\u5165\u4ef7/\u5356\u51fa\u4ef7\u5217(4\u4f4d\u7cbe\u5ea6,\u6301\u4ed3\u4e2d\u663e\u793a\u6301\u4ed3\u4e2d\u6807\u7b7e)",
    "\u5220\u9664\u5cf0\u503c\u540c\u65f6\u6301\u4ed3\u7b14\u6570\u6052\u503c\u5217,\u6570\u503c\u79fb\u81f3\u8868\u4e0a\u65b9\u8bf4\u660e\u6761(\u5168\u53f2\u5cf0\u503c\u53e3\u5f84)"
  ],
  "20260907-a552": [
    "\u9996\u9875\u89d2\u6807 snap \u5c31\u7eea\u5373\u81ea\u52a8\u91cd\u7ed8,\u4fee\u590d\u5f31\u7f51\u4e0b\u89d2\u6807\u4e0d\u81ea\u52a8\u5237\u65b0",
    "\u4fe1\u53f7\u8d70\u52bf\u56fe\u5f53\u65e5\u6570\u636e\u8865\u70b9\u6210\u529f\u4e0d\u518d\u6b8b\u7559\u300c\u7b4917:50\u300d\u6ede\u540e\u63d0\u793a"
  ],
  "20260907-a551": [
