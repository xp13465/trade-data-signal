# OAuth 后端环境变量（本地开发 + 生产部署均需配置）
# 复制为 .env 或导出到 shell：source <(grep -v '^#' .env.example | sed 's/^/export /')
# ⚠️ 真实 secret 不要提交 git，.env 应加入 .gitignore

# ---- Gitee OAuth ----
# 在 https://gitee.com/oauth/applications 新建应用，回调地址填：
#   本地开发：http://localhost:8000/api/auth/callback/gitee
#   生产：     https://ss.fx8.store/api/auth/callback/gitee（注意：生产需 Workers 实现或配 origin，见 app/auth.py 注释）
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
GITEE_REDIRECT_URI=http://localhost:8000/api/auth/callback/gitee

# ---- session 签名密钥 ----
# 用于 HMAC 签名 session cookie，任意随机字符串（建议 >=32 字节）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

