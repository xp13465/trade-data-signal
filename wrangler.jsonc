// Cloudflare Workers Static Assets 配置。
// 加最小 Worker 脚本接管 response headers，实现 last-wins 覆盖 + 缓存分层
// （_headers 文件追加语义无法实现分层，见 worker/headers.js 注释）。
// push 到 main 后 Cloudflare 构建环境跑 wrangler deploy，内置 esbuild 自动 bundle worker/headers.js。
// C 方案（2026-07-24）：KV 存订阅（/api/subscribe CRUD），SUBSCRIBE_PASSWORD secret 认证。
//   2026-07-28：KV namespace 已创建（id 见下），剩 wrangler secret put SUBSCRIBE_PASSWORD 设密码。
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "trade-data-signal",
	"compatibility_date": "2026-07-07",
	"main": "worker/headers.js",
	"assets": {
		"directory": "./static-site",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	// 订阅接口 KV 存储（C 方案）。2026-07-28 已创建 namespace 并填入 id（wrangler kv namespace create）。
	// local dev 用 remote namespace（wrangler 自动加 remote:true）。
	"kv_namespaces": [
		{
			"binding": "SUBSCRIBE_KV",
			"id": "7d373c3365314ec7a334ac47a73f1578",
			"remote": true
		}
	],
	// R2 bucket binding（P0-4 2026-08-08）：/r2/* 路由直读 R2 对象 + Cache API 边缘缓存 1h。
	// 替代原 ssd.fx8.store public bucket 直链（cf-cache-status DYNAMIC 每次回源 ~1s）。
	// upload_r2.py 仍上传到 signal-data bucket，Worker 用 binding 直读，前端改走 ss.fx8.store/r2/。
	"r2_buckets": [
		{ "binding": "R2_BUCKET", "bucket_name": "signal-data" }
	],
	// D1 数据库 binding（#79 方案C 2026-08-22）：场外基金评分全量 27418 只分页查询。
	// 数据由 scripts/sync_fund_score_to_d1.sh 从本地 public_fund.db fund_score 全量同步（幂等可重跑），
	// worker/fund_score.js 提供 /api/fund_score 分页/筛选/排序/搜索接口。
	"d1_databases": [
		{
			"binding": "FUND_SCORE_DB",
			"database_name": "trade-fund-score",
			"database_id": "68c19715-3570-4f1d-8430-ec43dd856b5e"
		}
	]
}