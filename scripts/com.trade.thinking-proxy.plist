<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- thinking-proxy launchd 守护(2026-09-01 重构:独立 sensenova-rotate 纯 key 轮换代理)
     用途:常驻 sensenova-rotate-proxy.sh -> sensenova-rotate-proxy.py,对商汤 token.sensenova.cn 做 5 把 key
          纯 round-robin 轮换 + 429 换 key 重试,缓解商汤对 deepseek-v4-flash 按 RPM 限流(单 token 撞 429 死限流)。
          本代理只做 key 轮换,不含任何 thinking 注入/别名改写逻辑(与 thinking_proxy.py 完全无关、独立)。
     5 把 key:SENSENOVA_KEY1/2/3/4/5 存 ../trade-data/.env(仓外),由 wrapper 脚本注入,真实 key 禁进本 plist/git。
     激活:launchctl load scripts/com.trade.thinking-proxy.plist
     停用:launchctl unload scripts/com.trade.thinking-proxy.plist
     一键回退(还原 settings 直连单 token 原状 + 停代理):bash scripts/thinking-proxy-rollback.sh sento
     settings 切换:ANTHROPIC_BASE_URL 需指到本代理(http://127.0.0.1:8899)才能走轮换,但切换由用户拍板,
          本次实现未动 settings(仍保持 token.sensenova.cn 直连原状)。
     风险(P0):代理挂=商汤轮换不可用;KeepAlive 守护秒级重启+claude 重试兜底 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trade.thinking-proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/linhuichen/code/trade/scripts/sensenova-rotate-proxy.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SENSENOVA_ENV_FILE</key>
        <string>/Users/linhuichen/code/trade-data/.env</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/linhuichen/code/trade-data/data/logs/sensenova-rotate.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/linhuichen/code/trade-data/data/logs/sensenova-rotate.err</string>
</dict>
</plist>
