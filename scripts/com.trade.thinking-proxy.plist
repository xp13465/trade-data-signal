<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- thinking-proxy launchd 守护(2026-08-17 coding plan 版:TTP_PROVIDER 一键切官方/火山方舟 coding/火山方舟 agent plan)
     用途:常驻 thinking_proxy.py,对 deepseek-v4-flash 注入 thinking:disabled 省 token(per-role 执行类);
          deepseek-v4-think 别名改写回 flash(判断类保思考;agent plan/coding/官方直发别名都报错,须走代理改写)
     切端:改 TTP_PROVIDER = official(现网 2026-08-19,官方 api.deepseek.com/anthropic) | ark(方舟 coding 端点) | ark-plan(火山 agent plan 端点),
          然后 launchctl unload + load。settings.json 的 ANTHROPIC_AUTH_TOKEN 需对应 provider 的 key。
     详见 docs/thinking-off-optimization.md §九(方舟版)/§八(官方版)
     激活:launchctl load scripts/com.trade.thinking-proxy.plist
     停用:launchctl unload scripts/com.trade.thinking-proxy.plist
     一键回退:bash scripts/thinking-proxy-rollback.sh
     风险(P0):代理挂=全站 claude 不可用;KeepAlive 守护秒级重启+claude 重试兜底 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trade.thinking-proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/linhuichen/code/trade/scripts/thinking_proxy.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TTP_INJECT</key>
        <string>1</string>
        <key>TTP_INJECT_MODELS</key>
        <string>deepseek-v4-flash</string>
        <key>TTP_ALIAS_MODELS</key>
        <string>deepseek-v4-think</string>
        <key>TTP_ALIAS_TARGET</key>
        <string>deepseek-v4-flash</string>
        <key>TTP_PROVIDER</key>
        <string>official</string>
        <key>TTP_UPSTREAM_HOST</key>
        <string>api.deepseek.com</string>
        <key>TTP_UPSTREAM_PORT</key>
        <string>443</string>
        <key>TTP_UPSTREAM_BASE</key>
        <string>/anthropic</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/linhuichen/code/trade-data/data/logs/thinking-proxy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/linhuichen/code/trade-data/data/logs/thinking-proxy.err</string>
</dict>
</plist>
