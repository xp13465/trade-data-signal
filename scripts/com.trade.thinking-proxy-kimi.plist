<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- thinking-proxy-kimi launchd 守护(2026-09-01 新增:kimi-k3 版 5key 轮换代理)
     用途:常驻 sensenova-rotate-proxy-kimi.sh -> sensenova-rotate-proxy-kimi.py,对商汤 token.sensenova.cn
          做 5 把 key 纯 round-robin 轮换 + 429 换 key 重试。kimi-k3 为商汤新支持模型
          (thinking/non-thinking + 1M context + 工具,与 v4-flash 同形态)。
         与 v4-flash 版(com.trade.thinking-proxy/8899)独立:本代理走 8898,两者可同时常驻互不干扰。
     本版差异:去掉 v4-flash 版的 _strip_thinking_adaptive 参数剔除逻辑(body 原样转发),其余逻辑
         (5key 加载/429 换 key/冷却/高峰限频/轮换)与 v4-flash 版一致。
     5 把 key:SENSENOVA_KEY1/2/3/4/5 存 ../trade-data/.env(仓外),由 wrapper 脚本注入,真实 key 禁进本 plist/git。
     激活:launchctl load scripts/com.trade.thinking-proxy-kimi.plist
     停用:launchctl unload scripts/com.trade.thinking-proxy-kimi.plist
     settings 切换:bash scripts/kimi-proxy-switch.sh kimi / v4flash(双向切换 ANTHROPIC_BASE_URL+MODEL,不碰 launchd)
     风险(P0):代理挂=商汤轮换不可用;KeepAlive 守护秒级重启+claude 重试兜底 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trade.thinking-proxy-kimi</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/linhuichen/code/trade/scripts/sensenova-rotate-proxy-kimi.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SENSENOVA_ENV_FILE</key>
        <string>/Users/linhuichen/code/trade-data/.env</string>
        <key>TTP_PORT</key>
        <string>8898</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/linhuichen/code/trade-data/data/logs/sensenova-rotate-kimi.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/linhuichen/code/trade-data/data/logs/sensenova-rotate-kimi.err</string>
</dict>
</plist>