    <string>/Users/linhuichen/code/trade-data/data/logs/turnover_backfill_launchd.err</string>
    <key>RunAtLoad</key>
    <false/>
    <!-- codex008 F5 更正: ExitTimeOut 不是运行时长超时, 只是任务被停止(SIGTERM)后等待
         优雅退出再 SIGKILL 的宽限窗口。防挂死由 turnover_backfill.sh 内 run_to 超时包装承担
         (pipeline 7200s + 重导/上传 600s); 此处 300s 仅保证超时被杀时日志 flush 留全 -->
    <key>ExitTimeOut</key>
    <integer>300</integer>
